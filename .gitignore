# Ignore everything in secrets and provider except .gitkeep
secrets/*
!secrets/.gitkeep

provider/*
!provider/.gitkeep

# Standard Terraform ignores (prevents leaking state files)
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
